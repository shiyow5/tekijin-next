# ============================================================
# Dependencies
# ============================================================
node_modules/
.pnpm-store/
.npm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.eggs/

# ============================================================
# Build output
# ============================================================
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo
dist/
build/

# ============================================================
# Environment & secrets
# ============================================================
.env
# `.env` alone does not cover a dated backup — and a teardown that copies
# secrets next to it would otherwise be one `git add .` away from committing them.
.env.bak*
env.bak*
.env.local
.env.*.local
.env.production
!.env.example
# JSON credentials / service accounts must never be committed
*-service-account*.json
*credentials*.json

# ============================================================
# Test & coverage
# ============================================================
coverage/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.auth/
frontend/playwright/.cache/
frontend/blob-report/

# ============================================================
# Docker
# ============================================================
docker-compose.override.yml

# ============================================================
# Logs
# ============================================================
*.log
npm-debug.log*
pnpm-debug.log*

# ============================================================
# OS files
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================================
# IDE
# ============================================================
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ============================================================
# Local data / models (never commit datasets or model weights)
# ============================================================
data/
# ...but the backend source package `tekijin.data` is real code, not a dataset.
!backend/src/tekijin/data/
!backend/src/tekijin/data/**
*.sqlite
*.duckdb
*.bin
*.gguf
*.safetensors
# keep build artifacts out of the tracked data package
backend/src/tekijin/data/**/__pycache__/

# 測定ハーネスの中間生成物（#65 / #73）。埋め込みは GPU で作り直せるので追跡しない。
# 採否の根拠として残すのは docs/benchmarks/ablation/ の LLM 実出力だけ。
/emb/
*.npz
/llm_*.json
/rr_*.json
/payload_*.json

# Agent worktrees (Claude Code)
.claude/worktrees/
